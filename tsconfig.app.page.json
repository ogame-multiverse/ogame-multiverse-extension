{
  "extends": "./tsconfig.app.base.json",
  "compilerOptions": {
    "outDir": "dist"
  },
  "include": [
    "src/app/contexts/page.entry.ts",
    "src/app/contexts/sidePanel.entry.ts",
    "src/app/pageContext/**/*.ts",
    "src/app/sidePanelContext/**/*.ts",
    "src/app/shared/**/*.ts",
    "src/framework/**/*.ts",
    "src/localization/**/*.ts",
    "src/model/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["src/app/contentContext/**/*.ts", "src/app/serviceWorkerContext/**/*.ts"]
}
