{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "sourceMap": false,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  }
}