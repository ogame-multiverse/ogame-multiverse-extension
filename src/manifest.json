{
  "manifest_version": 3,
  "name": "OGame Multiverse",
  "version": "0.0.0",
  "description": "OGame Multiverse is an extension helping you to play multiple universe at time.",
  "update_url": "https://clients2.google.com/service/update2/crx",
  "host_permissions": [ "https://*.ogame.gameforge.com/game/*" ],
  "permissions": [ "contextMenus", "storage", "sidePanel" ],
  "icons": {
    "512": "assets/images/logo.png",
    "256": "assets/images/logo.png",
    "128": "assets/images/logo.png",
    "32": "assets/images/logo.png"
  },
  "action": {
    "default_icon": {
      "32": "assets/images/logo.png"
    },
    "default_title": "Ogame Multiverse"
  },
  "side_panel": {
    "default_path": "views/sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "matches": [ "<all_urls>" ],
      "resources": [ "assets/images/*", "views/*" ]
    }
  ],
  "commands": {
    "toggle_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "Open Side Panel"
    }
  },
  "content_scripts": [
    {
      "css": [ "app.css" ],
      "js": [ "app.content.js" ],
      "run_at": "document_start",
      "matches": [ "https://*.ogame.gameforge.com/game/*" ],
      "exclude_matches": [ "https://*.gameforge.com/game/admin2/*", "https://*.ogame.gameforge.com/game/index.php?page=standalone&component=empire" ]
    }
  ],
  "background": {
    "service_worker": "app.worker.js"
  }
}
